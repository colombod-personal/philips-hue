{
  "name": "@hue-sdk/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Philips Hue bridges: discover, pair, inspect devices and sensors, control lights. JSON output for agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hue": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hue-sdk/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colombod-personal/philips-hue",
    "directory": "packages/cli"
  }
}
