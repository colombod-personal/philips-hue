{
  "name": "@hue-sdk/core",
  "version": "0.1.0",
  "description": "Device-centric Philips Hue (CLIP v2) SDK: discovery, pairing, devices, sensors, lights and live events. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support/index.d.ts",
      "import": "./dist/test-support/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "philips-hue",
    "hue",
    "clip-v2",
    "smart-home",
    "sensors",
    "agents",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/colombod-personal/philips-hue",
    "directory": "packages/core"
  }
}
