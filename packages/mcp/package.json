{
  "name": "@hue-sdk/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing Philips Hue devices, sensors, lights and scenes to AI agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hue-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hue-sdk/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colombod-personal/philips-hue",
    "directory": "packages/mcp"
  }
}
