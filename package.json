{
  "name": "philips-hue-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Device-centric Philips Hue SDK, CLI, MCP server and agent skill (MIT)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm -r --filter './packages/*' run test",
    "lint": "pnpm -r --filter './packages/*' run lint",
    "clean": "pnpm -r --filter './packages/*' exec rm -rf dist *.tsbuildinfo",
    "hue": "node packages/cli/dist/bin.js",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
